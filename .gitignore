# Public repository boundary: new root paths stay local until explicitly allowed.
/*
!/.gitignore
!/README.md
!/LICENSE.md
!/app/
!/docs/

# Application source, manifests, lockfiles, static assets and synthetic tests.
/app/*
!/app/LICENSE.md
!/app/NOTICE.md
!/app/blocked_email_domains.txt
!/app/docker-compose.yml
!/app/manage.py
!/app/package.json
!/app/package-lock.json
!/app/pyproject.toml
!/app/uv.lock
!/app/tailwind.config.js
!/app/crispy_tailwind/
!/app/demoapp/
!/app/mainapp/
!/app/project/
!/app/speedpycom/
!/app/static/
!/app/templates/
!/app/usermodel/

# Public documentation is also opt-in.
/docs/*
!/docs/third-party.md
!/docs/github.md
!/docs/operations.md
!/docs/images/
/docs/images/*
!/docs/images/workspace.png
!/docs/images/workspace-dark.png

# Internal work, research checkouts, agent state and editor configuration.
.agent/
.agents/
.claude/
.codex/
.github-local/
.idea/
.vscode/
.codegraph/
workspace/
AGENTS.md
CLAUDE.md
.DS_Store
._*
*~
*.swp
*.swo

