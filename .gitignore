.env
.env.*
.aws/
.ssh/
.gnupg/
.kube/
.netrc
.pypirc
.npmrc
credentials*.json
service-account*.json
service_account*.json
authorized_key*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Dependencies, caches, build outputs and machine-specific generated paths.
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.cache/
*.egg-info/
build/
dist/
staticfiles/
media/
tailwind_directories.json

# Local databases, dumps, encrypted archives, exports, uploads and logs.
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.sql
*.dump
*.backup
*.bak
*.enc
*.fernet
*.rdb
